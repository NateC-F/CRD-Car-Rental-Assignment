DROP DATABASE IF EXISTS CarRentalProgram;

CREATE DATABASE CarRentalProgram;
USE CarRentalProgram;



-- =================================================================================
CREATE TABLE cars
(
  car_id		INT 		PRIMARY KEY 		AUTO_INCREMENT,
  car_model					VARCHAR(35)			NOT NULL,
  car_license_plate 		VARCHAR(6)			UNIQUE NOT NULL,
  car_type					ENUM('SEDAN','SUV','VAN') NOT NULL,
  car_fuel_type				ENUM('GAS','DIESEL','ELECTRIC','HYBRID') NOT NULL,
  car_miles 	INT NOT NULL,
  car_tank_capacity			DOUBLE NOT NULL,
  car_in_use	BOOLEAN NOT NULL DEFAULT FALSE
);
-- =================================================================================
CREATE TABLE customers
(
  customer_id	INT 		PRIMARY KEY			AUTO_INCREMENT,
  customer_name				VARCHAR(30) NOT NULL,
  customer_license			VARCHAR(10) 		UNIQUE NOT NULL
);
-- =================================================================================
CREATE TABLE reservations
(
    invoice_number 			INT PRIMARY KEY AUTO_INCREMENT,
    customer_id 			INT NOT NULL,
    car_id 					INT NOT NULL,
	reservation_start 		DATE NOT NULL,
    reservation_end 		DATE NOT NULL,
	is_late         		BOOLEAN  NOT NULL DEFAULT FALSE,
    actual_return_date   	DATE,

    CONSTRAINT fk_reservation_customer
        FOREIGN KEY (customer_id)
        REFERENCES customers(customer_id)
        ON UPDATE CASCADE,

    CONSTRAINT fk_reservation_car
        FOREIGN KEY (car_id)
        REFERENCES cars(car_id)
        ON UPDATE CASCADE,

	CONSTRAINT verify_reservation_dates
        CHECK (reservation_end > reservation_start)
);


