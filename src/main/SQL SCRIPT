-- =================================================================================
CREATE EVENT update_cars_when_reservation_starts
ON SCHEDULE EVERY 1 DAY
STARTS CURRENT_TIMESTAMP
DO
    UPDATE cars c
    JOIN reservations r ON c.car_id = r.car_id
    SET c.car_in_use = TRUE
    WHERE r.reservation_start = CURDATE()
      AND r.actual_return_date IS NULL;
